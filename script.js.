
"use strict";

// North Star Bakery - Touchstone 4
// Interactivity, form validation, and browser storage

document.addEventListener("DOMContentLoaded", initializeBakery);

const PRODUCTS = [
  { id: "artisan-bread", name: "Artisan Bread" },
  { id: "signature-loaf", name: "Signature Homemade Loaf" },
  { id: "pastries", name: "Fresh Pastries" },
  { id: "celebration-cake", name: "Celebration Cake" },
  { id: "custom-order", name: "Custom Bakery Order" }
];

const INQUIRIES = [
  { id: "general", name: "General Question" },
  { id: "product", name: "Product Information" },
  { id: "preorder", name: "Preorder Inquiry" },
  { id: "cake", name: "Custom Cake Inquiry" },
  { id: "other", name: "Other" }
];

const STORAGE_KEY = "northStarBakeryPreferences";

function initializeBakery() {
  const form = document.querySelector("#bakery-contact-form");

  if (!form) return;

  restorePreferences(form);
  updatePreorderSummary(form);

  form.addEventListener("input", () => {
    updatePreorderSummary(form);
    clearFieldErrors(form);
  });

  form.addEventListener("change", () => {
    updatePreorderSummary(form);
    savePreferences(form);
    clearFieldErrors(form);
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    if (validateForm(form)) {
      savePreferences(form);

      const feedback = document.querySelector("#form-feedback");
      if (feedback) {
        feedback.textContent =
          "Your inquiry passed validation! This is a demonstration, so no information was sent to the bakery.";
        feedback.className = "form-success";
      }
    }
  });

  form.addEventListener("reset", () => {
    localStorage.removeItem(STORAGE_KEY);

    setTimeout(() => {
      clearFieldErrors(form);
      updatePreorderSummary(form);

      const feedback = document.querySelector("#form-feedback");
      if (feedback) feedback.textContent = "";
    }, 0);
  });
}

function getProductName(productId) {
  const product = PRODUCTS.find(item => item.id === productId);
  return product ? product.name : "No product selected";
}

function getInquiryName(inquiryId) {
  const inquiry = INQUIRIES.find(item => item.id === inquiryId);
  return inquiry ? inquiry.name : "Not selected";
}

function updatePreorderSummary(form) {
  const summary = document.querySelector("#preorder-summary");
  if (!summary) return;

  const product = form.elements["product"].value;
  const quantity = form.elements["quantity"].value;
  const inquiry = form.elements["inquiry_type"].value;
  const pickupDate = form.elements["pickup_date"].value;

  const lines = [
    "Inquiry: " + getInquiryName(inquiry),
    "Product: " + getProductName(product),
    "Quantity: " + (quantity || "Not specified"),
    "Preferred pickup: " + (pickupDate || "Not specified")
  ];

  summary.textContent = lines.join("\n");
}

function savePreferences(form) {
  const preferences = {
    product: form.elements["product"].value,
    inquiryType: form.elements["inquiry_type"].value,
    contactMethod:
      form.querySelector('input[name="contact_method"]:checked')
        ?.value || "email"
  };

  try {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(preferences)
    );
  } catch (error) {
    console.warn("Browser storage unavailable.", error);
  }
}

function restorePreferences(form) {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return;

    const preferences = JSON.parse(saved);

    if (preferences.product) {
      form.elements["product"].value = preferences.product;
    }

    if (preferences.inquiryType) {
      form.elements["inquiry_type"].value =
        preferences.inquiryType;
    }

    const contactMethod = form.querySelector(
      'input[name="contact_method"][value="' +
      preferences.contactMethod + '"]'
    );

    if (contactMethod) contactMethod.checked = true;

    const storageMessage =
      document.querySelector("#storage-feedback");

    if (storageMessage) {
      storageMessage.textContent =
        "Your previous bakery preferences were restored.";
    }
  } catch (error) {
    console.warn("Could not restore preferences.", error);
  }
}

function showFieldError(fieldId, message) {
  const field = document.getElementById(fieldId);
  const error = document.getElementById(fieldId + "-error");

  if (field) field.setAttribute("aria-invalid", "true");
  if (error) error.textContent = message;
}

function clearFieldErrors(form) {
  form.querySelectorAll(".field-error").forEach(element => {
    element.textContent = "";
  });

  form.querySelectorAll("[aria-invalid]").forEach(element => {
    element.removeAttribute("aria-invalid");
  });
}

function validateForm(form) {
  clearFieldErrors(form);

  let valid = true;

  const name = form.elements["full_name"].value.trim();
  const email = form.elements["email"].value.trim();
  const message = form.elements["message"].value.trim();
  const inquiry = form.elements["inquiry_type"].value;
  const quantity = form.elements["quantity"].value;

  if (name.length < 2) {
    showFieldError(
      "full-name",
      "Please enter your full name (at least 2 characters)."
    );
    valid = false;
  }

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if (!emailPattern.test(email)) {
    showFieldError(
      "email",
      "Please enter a valid email address."
    );
    valid = false;
  }

  if (!inquiry) {
    showFieldError(
      "inquiry-type",
      "Please select an inquiry type."
    );
    valid = false;
  }

  if (message.length < 10) {
    showFieldError(
      "message",
      "Please enter at least 10 characters."
    );
    valid = false;
  }

  if (
    quantity &&
    (!Number.isInteger(Number(quantity)) ||
      Number(quantity) < 1 ||
      Number(quantity) > 100)
  ) {
    showFieldError(
      "quantity",
      "Quantity must be a whole number between 1 and 100."
    );
    valid = false;
  }

  const feedback = document.querySelector("#form-feedback");

  if (feedback && !valid) {
    feedback.textContent =
      "Please correct the highlighted fields before submitting.";
    feedback.className = "form-error";
  }

  if (!valid) {
    const firstInvalid = form.querySelector(
      '[aria-invalid="true"]'
    );

    if (firstInvalid) firstInvalid.focus();
  }

  return valid;
}

/* ========================================
   TOUCHSTONE 4: JAVASCRIPT INTERACTIVITY
   ======================================== */

/* Live preorder summary */
.interactive-summary {
    margin: 2rem 0;
    padding: 1.5rem;
    background-color: #fff8ef;
    border: 2px solid var(--brown, #795548);
    border-radius: 10px;
}

.interactive-summary h3 {
    margin-top: 0;
    color: var(--charcoal, #333333);
}

#preorder-summary {
    padding: 1rem;
    background-color: #ffffff;
    border-left: 4px solid var(--brown, #795548);
    border-radius: 5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: inherit;
    line-height: 1.7;
}

/* Validation feedback */
.field-error {
    display: block;
    margin-top: 0.35rem;
    color: #a32020;
    font-size: 0.9rem;
    font-weight: 600;
}

input[aria-invalid="true"],
select[aria-invalid="true"],
textarea[aria-invalid="true"] {
    border: 2px solid #a32020;
    background-color: #fff5f5;
}

/* Form submission feedback */
#form-feedback,
#storage-feedback {
    margin-top: 1rem;
    font-weight: 600;
}

#form-feedback:not(:empty),
#storage-feedback:not(:empty) {
    padding: 0.75rem;
    border-radius: 5px;
    background-color: #f2f6ed;
}

/* Mobile responsiveness */
@media (max-width: 600px) {
    .interactive-summary {
        padding: 1rem;
    }

    #preorder-summary {
        font-size: 0.9rem;
    }
}
